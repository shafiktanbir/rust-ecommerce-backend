# ─────────────────────────────────────────────────────────────────────────────
# Application environment variables
# Copy this file to .env and fill in values for local development.
# NEVER commit .env to git. Only commit .env.example.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string for sqlx
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://ecommerce:ecommerce_secret@localhost:5432/ecommerce_lab

# PostgreSQL credentials (used by docker-compose.yml)
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_secret
POSTGRES_DB=ecommerce_lab
POSTGRES_PORT=5432

# Application settings
APP_PORT=8080
APP_ENV=development

# Logging level
# Options: error, warn, info, debug, trace
# For SQL query logging: RUST_LOG=sqlx=debug,ecommerce_lab=debug
RUST_LOG=ecommerce_lab=debug,tower_http=debug
